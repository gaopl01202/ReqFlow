{
  "name": "reqflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test:e2e": "playwright test",
    "generate:api": "openapi-typescript ../docs/openapi.yaml -o src/generated/api.d.ts && prettier --write src/generated/api.d.ts",
    "predev": "node scripts/sync-editor.mjs && node scripts/sync-preview-assets.mjs",
    "prebuild": "node scripts/sync-editor.mjs && node scripts/sync-preview-assets.mjs",
    "sync:document-formats": "node scripts/sync-document-formats.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@file-viewer/assets-ppt": "3.2.2",
    "@file-viewer/assets-standard": "3.2.2",
    "@file-viewer/react": "3.2.2",
    "@file-viewer/renderer-archive": "3.2.2",
    "@file-viewer/renderer-drawing": "3.2.2",
    "@file-viewer/renderer-image": "3.2.2",
    "@file-viewer/renderer-media": "3.2.2",
    "@file-viewer/renderer-mindmap": "3.2.2",
    "@file-viewer/renderer-pdf": "3.2.2",
    "@file-viewer/renderer-presentation": "3.2.2",
    "@file-viewer/renderer-spreadsheet": "3.2.2",
    "@file-viewer/renderer-text": "3.2.2",
    "@file-viewer/renderer-word": "3.2.2",
    "@file-viewer/vite-plugin": "3.2.2",
    "antd": "^6.0.0",
    "dayjs": "^1.11.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "vditor": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
