# Copy to .env locally; never commit the filled file. Export before running Django.
DEBUG=1
PGDATABASE=reqflow
PGUSER=reqflow
PGHOST=127.0.0.1
PGPORT=55432
# PGPASSWORD=use-a-local-secret
# SECRET_KEY=generate-a-unique-random-value-for-production
ALLOWED_HOSTS=127.0.0.1,localhost
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.txt,.md,.csv,.zip,.docx,.xlsx
# PRIVATE_STORAGE=/path/to/private-attachments
# CSRF_TRUSTED_ORIGINS=https://reqflow.example.com
DOCUMENT_MAX_BYTES=10485760

# Actual user activity renews idle timeout; absolute login lifetime stays fixed.
SESSION_IDLE_TIMEOUT_SECONDS=604800
