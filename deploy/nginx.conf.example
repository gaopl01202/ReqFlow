# Replace host, paths, and certificate locations before deployment.
server {
    listen 443 ssl;
    server_name reqflow.example.com;
    ssl_certificate /etc/ssl/reqflow/fullchain.pem;
    ssl_certificate_key /etc/ssl/reqflow/privkey.pem;
    client_max_body_size 11m;
    root /opt/reqflow/frontend/dist;
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
    location / { try_files $uri /index.html; }
    # Private attachments have no static alias.
}
server { listen 80; server_name reqflow.example.com; return 301 https://$host$request_uri; }
